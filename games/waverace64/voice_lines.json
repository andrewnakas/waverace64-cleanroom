 "2034A0_00CAD0": {
  "who": "announcer",
  "text": "Press up and down on the control stick to lean the rider forward and back."
 },
 "2034A0_014770": {
  "who": "announcer",
  "text": "When you jump, you can control the height of your jump by leaning the rider forward or back."
 },
 "2034A0_01F610": {
  "who": "announcer",
  "text": "To corner sharply, press down on the control stick while turning."
 },
 "2034A0_026D00": {
  "who": "announcer",
  "text": "To do a barrel roll while on the ramp, quickly move the control stick left, then right, and hold."
 },
 "2034A0_033730": {
  "who": "announcer",
  "text": "To do a barrel roll while on the ramp, quickly move the control stick right, then left, and hold."
 },
 "2034A0_03F860": {
  "who": "announcer",
  "text": "To do a flip, while on the ramp, quickly move the control stick up, then down, and hold."
 },
 "2034A0_04B5D0": {
  "who": "announcer",
  "text": "To ride backwards, release the throttle, rotate the control stick clockwise, then push it down and hold."
 },
 "2034A0_057460": {
  "who": "announcer",
  "text": "To ride standing up, release the throttle, rotate the control stick counterclockwise, then push it up and hold."
 },
 "2034A0_062CE0": {
  "who": "announcer",
  "text": "To do a handstand, release the throttle and quickly move the control stick down, then up and hold."
 },
